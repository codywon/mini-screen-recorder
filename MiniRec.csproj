<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\MiniRec.ico</ApplicationIcon>
    <AssemblyName>MiniRec</AssemblyName>
    <RootNamespace>MiniRec</RootNamespace>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>MiniRec</Product>
    <Description>Win11 极简隐身桌面录屏工具</Description>
    <Copyright>Copyright © 2026 MiniRec</Copyright>
  </PropertyGroup>
</Project>
