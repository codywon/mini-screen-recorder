<Window x:Class="MiniRec.Views.CloseConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关闭悬浮条 - MiniRec"
        Width="356"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="DialogBtnStyle" TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Foreground" Value="#CBD5E1" />
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="12"
            Background="#F20F172A"
            BorderBrush="#334155"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16,14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10"
                              ShadowDepth="2"
                              Opacity="0.4"
                              Color="#000000" />
        </Border.Effect>

        <StackPanel>
            <Grid Margin="0,0,0,10"
                  Background="Transparent"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="关闭悬浮控制条"
                           Foreground="#F8FAFC"
                           FontSize="13.5"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Button HorizontalAlignment="Right"
                        Width="24"
                        Height="24"
                        Content="✕"
                        Foreground="#94A3B8"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Focusable="False"
                        Click="CancelButton_Click" />
            </Grid>

            <TextBlock Text="点击悬浮条关闭按钮时，你希望 MiniRec 执行什么操作？（之后可在系统托盘菜单随时更改）"
                       Foreground="#CBD5E1"
                       FontSize="12"
                       TextWrapping="Wrap"
                       LineHeight="18"
                       Margin="0,0,0,12" />

            <CheckBox x:Name="RememberCheckBox"
                      IsChecked="True"
                      Content="记住我的选择，以后不再每次提示"
                      Foreground="#94A3B8"
                      FontSize="12"
                      Margin="0,0,0,14" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource DialogBtnStyle}"
                        Content="取消"
                        Margin="0,0,8,0"
                        Click="CancelButton_Click" />
                <Button Style="{StaticResource DialogBtnStyle}"
                        Foreground="#FCA5A5"
                        BorderBrush="#7F1D1D"
                        Background="#2A1215"
                        Content="彻底退出"
                        Margin="0,0,8,0"
                        Click="ExitButton_Click" />
                <Button Style="{StaticResource DialogBtnStyle}"
                        Background="#2563EB"
                        BorderBrush="#3B82F6"
                        Foreground="#FFFFFF"
                        FontWeight="SemiBold"
                        Content="最小化到托盘"
                        Click="MinimizeButton_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
