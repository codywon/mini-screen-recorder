<Window x:Class="MiniRec.Views.RegionOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MiniRec Region Selector"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Cursor="Cross"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseMove="Window_MouseMove"
        MouseLeftButtonUp="Window_MouseLeftButtonUp"
        MouseRightButtonDown="Window_MouseRightButtonDown">

    <Window.Resources>
        <Style x:Key="ToolbarIconBtnStyle" TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E2E8F0" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#CBD5E1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarRecordBtnStyle" TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="#EF4444" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ResizeHandleStyle" TargetType="Rectangle">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Fill" Value="#07C160" />
            <Setter Property="Stroke" Value="#FFFFFF" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
    </Window.Resources>

    <Canvas x:Name="RootCanvas" Background="#01000000">
        <!-- 半透明暗色遮罩，选区或吸附窗口通过 CombinedGeometry 镂空 -->
        <Path x:Name="DimOverlayPath" Fill="#88000000" IsHitTestVisible="False" />

        <!-- 选区边框（微信绿 2px） -->
        <Border x:Name="SelectionBorder"
                Visibility="Collapsed"
                BorderBrush="#07C160"
                BorderThickness="2"
                Background="Transparent"
                IsHitTestVisible="False" />

        <!-- 8 个缩放手柄（四角 + 四边中点） -->
        <Rectangle x:Name="HandleTL" Style="{StaticResource ResizeHandleStyle}" />
        <Rectangle x:Name="HandleT"  Style="{StaticResource ResizeHandleStyle}" />
        <Rectangle x:Name="HandleTR" Style="{StaticResource ResizeHandleStyle}" />
        <Rectangle x:Name="HandleR"  Style="{StaticResource ResizeHandleStyle}" />
        <Rectangle x:Name="HandleBR" Style="{StaticResource ResizeHandleStyle}" />
        <Rectangle x:Name="HandleB"  Style="{StaticResource ResizeHandleStyle}" />
        <Rectangle x:Name="HandleBL" Style="{StaticResource ResizeHandleStyle}" />
        <Rectangle x:Name="HandleL"  Style="{StaticResource ResizeHandleStyle}" />

        <!-- 选区左上角物理像素尺寸标签 -->
        <Border x:Name="SizeBadge"
                Visibility="Collapsed"
                Background="#CC0F172A"
                CornerRadius="4"
                Padding="7,2"
                IsHitTestVisible="False">
            <TextBlock x:Name="SizeBadgeText"
                       Foreground="#F8FAFC"
                       FontFamily="Consolas, Segoe UI"
                       FontSize="12"
                       FontWeight="SemiBold" />
        </Border>

        <!-- 编辑态下方悬浮工具条（模仿微信截图工具条） -->
        <Border x:Name="ActionToolbar"
                Visibility="Collapsed"
                Background="#F8FAFC"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                CornerRadius="8"
                Padding="5,4"
                Cursor="Arrow">
            <Border.Effect>
                <DropShadowEffect BlurRadius="14"
                                  ShadowDepth="3"
                                  Opacity="0.35"
                                  Color="#000000" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource ToolbarIconBtnStyle}"
                        ToolTip="确认选区并立即开始录制"
                        Click="RecordNowButton_Click">
                    <Grid Width="14" Height="14">
                        <Ellipse Stroke="#EF4444" StrokeThickness="1.5" />
                        <Ellipse Width="7" Height="7" Fill="#EF4444" />
                    </Grid>
                </Button>
                <Border Width="1" Height="18" Background="#CBD5E1" Margin="2,0" />
                <Button Style="{StaticResource ToolbarIconBtnStyle}"
                        Content="↺"
                        ToolTip="重新选择区域（右键）"
                        Click="ReselectButton_Click" />
                <Button Style="{StaticResource ToolbarIconBtnStyle}"
                        Content="✕"
                        Foreground="#EF4444"
                        ToolTip="取消退出（Esc）"
                        Click="CancelButton_Click" />
                <Button Style="{StaticResource ToolbarIconBtnStyle}"
                        Content="✓"
                        Foreground="#07C160"
                        FontWeight="Bold"
                        FontSize="15"
                        ToolTip="确认选区（Enter / 双击选区）"
                        Click="ConfirmButton_Click" />
            </StackPanel>
        </Border>

        <!-- 悬停态顶部操作提示胶囊 -->
        <Border x:Name="HintPill"
                Background="#DD0F172A"
                BorderBrush="#475569"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14,6"
                IsHitTestVisible="False">
            <TextBlock x:Name="HintPillText"
                       Text="点击锁定窗口或拖动框选 · Esc 取消 · 右键恢复全屏"
                       Foreground="#E2E8F0"
                       FontSize="12.5" />
        </Border>
    </Canvas>
</Window>
