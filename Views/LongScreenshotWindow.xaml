<Window x:Class="MiniRec.Views.LongScreenshotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="滚动截长图 - MiniRec"
        Width="276"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="LongSubBtnStyle" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="#F3F4F6" />
            <Setter Property="Foreground" Value="#333333" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E5E7EB" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="Bd" Property="Background" Value="#E8F8EF" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#07C160" />
                                <Setter Property="Foreground" Value="#07C160" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LongPrimaryBtnStyle" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="#07C160" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#06AD56" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#05984B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="10"
            Background="#FFFFFF"
            BorderBrush="#1F000000"
            BorderThickness="1"
            CornerRadius="10"
            Padding="12,10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18"
                              ShadowDepth="4"
                              Direction="270"
                              Opacity="0.20"
                              Color="#000000" />
        </Border.Effect>

        <StackPanel>
            <!-- 标题栏（可拖拽） -->
            <Grid Margin="0,0,0,8"
                  Background="Transparent"
                  Cursor="SizeAll"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot"
                             Width="8"
                             Height="8"
                             Fill="#07C160"
                             Margin="0,0,7,0"
                             VerticalAlignment="Center" />
                    <TextBlock Text="滚动截长图"
                               Foreground="#1F2937"
                               FontSize="13.5"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="SizeInfoText"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Foreground="#6B7280"
                           FontFamily="Consolas, Segoe UI"
                           FontSize="11.5"
                           Text="0 × 0" />
            </Grid>

            <!-- 实时长图预览区 -->
            <Border Background="#F3F4F6"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="4"
                    Margin="0,0,0,8">
                <ScrollViewer x:Name="PreviewScroller"
                              Height="340"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Image x:Name="PreviewImage"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </ScrollViewer>
            </Border>

            <!-- 状态提示 -->
            <TextBlock x:Name="HintText"
                       Text="请将鼠标移到绿框内向下滚动，或点下方自动滚动"
                       Foreground="#4B5563"
                       FontFamily="Microsoft YaHei UI, Segoe UI"
                       FontSize="11.5"
                       TextWrapping="Wrap"
                       LineHeight="17"
                       Margin="0,0,0,10" />

            <!-- 滚动控制行 -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="AutoScrollBtn"
                        Grid.Column="0"
                        Style="{StaticResource LongSubBtnStyle}"
                        Content="▶ 自动向下滚动"
                        ToolTip="自动发送滚轮向下滚动，到底后自动停止 (Space)"
                        Click="AutoScrollBtn_Click" />
                <Button Grid.Column="2"
                        Style="{StaticResource LongSubBtnStyle}"
                        Content="重置"
                        ToolTip="清空当前长图重新开始拼接"
                        Click="ResetBtn_Click" />
            </Grid>

            <!-- 输出操作行 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Style="{StaticResource LongSubBtnStyle}"
                        Foreground="#F05252"
                        Padding="8,0"
                        Content="取消"
                        ToolTip="取消退出 (Esc)"
                        Click="CancelBtn_Click" />

                <Button Grid.Column="2"
                        Style="{StaticResource LongSubBtnStyle}"
                        Padding="9,0"
                        Content="贴图"
                        ToolTip="将长图钉在桌面上置顶"
                        Click="PinBtn_Click" />

                <Button Grid.Column="4"
                        Style="{StaticResource LongSubBtnStyle}"
                        Padding="9,0"
                        Content="保存"
                        ToolTip="保存长图为 PNG (Ctrl+S)"
                        Click="SaveBtn_Click" />

                <Button Grid.Column="6"
                        Style="{StaticResource LongPrimaryBtnStyle}"
                        Padding="8,0"
                        Content="复制完成"
                        ToolTip="复制长图到剪贴板并结束 (Enter)"
                        Click="CopyBtn_Click" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
