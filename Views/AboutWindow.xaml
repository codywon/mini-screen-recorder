<Window x:Class="MiniRec.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于 MiniRec"
        Width="360"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border Margin="12"
            Background="#F20F172A"
            BorderBrush="#334155"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16,14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10"
                              ShadowDepth="2"
                              Opacity="0.4"
                              Color="#000000" />
        </Border.Effect>

        <StackPanel>
            <Grid Margin="0,0,0,12"
                  Background="Transparent"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Fill="#EF4444" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="关于 MiniRec"
                               Foreground="#F8FAFC"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
                <Button HorizontalAlignment="Right"
                        Width="24"
                        Height="24"
                        Content="✕"
                        Foreground="#94A3B8"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Focusable="False"
                        Click="CloseButton_Click" />
            </Grid>

            <TextBlock x:Name="TitleVersionText"
                       Text="MiniRec v1.0.0"
                       Foreground="#F8FAFC"
                       FontSize="15"
                       FontWeight="Bold" />
            <TextBlock Text="Win11 极简原生隐身录屏 &amp; 微信式截图工具"
                       Foreground="#94A3B8"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,3,0,12" />

            <Border Background="#1E293B"
                    BorderBrush="#334155"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,10"
                    Margin="0,0,0,14">
                <StackPanel>
                    <Grid Margin="0,0,0,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="作者" Foreground="#94A3B8" FontSize="12" Margin="0,0,12,0" />
                        <TextBlock Grid.Column="1" Text="codywon" Foreground="#E2E8F0" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Margin="0,0,0,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="许可协议" Foreground="#94A3B8" FontSize="12" Margin="0,0,12,0" />
                        <TextBlock Grid.Column="1" Text="非商业许可 (Non-Commercial)" Foreground="#34D399" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Margin="0,0,0,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="项目主页" Foreground="#94A3B8" FontSize="12" Margin="0,0,12,0" />
                        <TextBlock Grid.Column="1"
                                   Text="GitHub 开源主页 ↗"
                                   ToolTip="https://github.com/codywon/mini-screen-recorder"
                                   Foreground="#60A5FA"
                                   FontSize="12"
                                   TextDecorations="Underline"
                                   Cursor="Hand"
                                   HorizontalAlignment="Right"
                                   MouseLeftButtonUp="RepoLink_MouseLeftButtonUp" />
                    </Grid>
                    <TextBlock Text="仅供个人学习、研究与非商业用途免费使用，禁止用于商业售卖或闭源打包分发。"
                               Foreground="#64748B"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="UpdateStatusText"
                       Visibility="Collapsed"
                       Foreground="#94A3B8"
                       FontSize="11.5"
                       TextWrapping="Wrap"
                       Margin="0,0,0,10" />

            <Grid>
                <Button x:Name="CheckUpdateBtn"
                        HorizontalAlignment="Left"
                        Height="28"
                        Padding="12,0"
                        Background="#1E293B"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        Foreground="#CBD5E1"
                        FontSize="12"
                        Cursor="Hand"
                        Focusable="False"
                        Content="检查更新"
                        Click="CheckUpdateButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="7"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#273549" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button HorizontalAlignment="Right"
                        Height="28"
                        Padding="16,0"
                        Background="#2563EB"
                        Foreground="#FFFFFF"
                        BorderThickness="0"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Focusable="False"
                        Content="确定"
                        Click="CloseButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="7"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </StackPanel>
    </Border>
</Window>
