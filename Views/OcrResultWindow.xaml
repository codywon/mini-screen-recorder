<Window x:Class="MiniRec.Views.OcrResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OCR 提取文字 - MiniRec"
        Width="540"
        Height="420"
        MinWidth="360"
        MinHeight="260"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="OcrActionBtnStyle" TargetType="Button">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Foreground" Value="#CBD5E1" />
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="12"
            Background="#F20F172A"
            BorderBrush="#334155"
            BorderThickness="1"
            CornerRadius="12"
            Padding="14,12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10"
                              ShadowDepth="2"
                              Opacity="0.4"
                              Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Margin="0,0,0,10"
                  Background="Transparent"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock x:Name="TitleInfoText"
                           Text="OCR 提取文字"
                           Foreground="#F8FAFC"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Button HorizontalAlignment="Right"
                        Width="24"
                        Height="24"
                        Content="✕"
                        Foreground="#94A3B8"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Focusable="False"
                        Click="CloseButton_Click" />
            </Grid>

            <Border Grid.Row="1"
                    Background="#1E293B"
                    BorderBrush="#334155"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="8">
                <TextBox x:Name="ResultTextBox"
                         Background="Transparent"
                         Foreground="#E2E8F0"
                         CaretBrush="#38BDF8"
                         BorderThickness="0"
                         FontFamily="Microsoft YaHei UI, Segoe UI"
                         FontSize="12.5"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" />
            </Border>

            <Grid Grid.Row="2" Margin="0,10,0,0">
                <Button x:Name="JoinLinesBtn"
                        HorizontalAlignment="Left"
                        Style="{StaticResource OcrActionBtnStyle}"
                        Content="去除换行"
                        Click="JoinLinesBtn_Click" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="CopiedHintText"
                               Text=""
                               Foreground="#34D399"
                               FontSize="11.5"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0" />
                    <Button Style="{StaticResource OcrActionBtnStyle}"
                            Background="#07C160"
                            BorderBrush="#07C160"
                            Foreground="#FFFFFF"
                            FontWeight="SemiBold"
                            Content="复制全部"
                            Click="CopyAllBtn_Click" />
                </StackPanel>
            </Grid>

            <!-- 右下角自由缩放抓手 -->
            <Thumb Grid.Row="2"
                   Width="16"
                   Height="16"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Margin="0,0,-10,-9"
                   Cursor="SizeNWSE"
                   ToolTip="拖动调整窗口大小"
                   DragDelta="ResizeThumb_DragDelta">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                            <Path Width="10" Height="10"
                                  Stroke="#64748B"
                                  StrokeThickness="1.3"
                                  StrokeStartLineCap="Round"
                                  Data="M 2,9 L 9,2 M 6,9 L 9,6" />
                        </Grid>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Grid>
    </Border>
</Window>
