<Window x:Class="MiniRec.Views.ScreenshotOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MiniRec.Views"
        Title="MiniRec Screenshot"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#000000"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        Cursor="Cross"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseWheel="Window_PreviewMouseWheel"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseMove="Window_MouseMove"
        MouseLeftButtonUp="Window_MouseLeftButtonUp"
        MouseRightButtonDown="Window_MouseRightButtonDown">

    <Window.Resources>
        <!-- 微信 4.0 风格主工具栏图标按钮（36×34 宽敞舒展热区 + 纤细线性风格） -->
        <Style x:Key="ShotToolbarIconBtnStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#333333" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F3F4F6" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E5E7EB" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="Bd" Property="Background" Value="#E8F8EF" />
                                <Setter Property="Foreground" Value="#07C160" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.30" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 取消退出图标按钮（微信同款透明底柔红细叉号） -->
        <Style x:Key="DangerToolbarIconBtnStyle" TargetType="Button" BasedOn="{StaticResource ShotToolbarIconBtnStyle}">
            <Setter Property="Foreground" Value="#F05252" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFF1F0" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFE1DF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 微信 4.0 同款透明底微信绿对勾完成按钮 -->
        <Style x:Key="PrimaryConfirmBtnStyle" TargetType="Button" BasedOn="{StaticResource ShotToolbarIconBtnStyle}">
            <Setter Property="Foreground" Value="#07C160" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E8F8EF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D3F3E1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 二级栏 / OCR 栏文字操作按钮 -->
        <Style x:Key="SubBarModeBtnStyle" TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#374151" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F2F3F5" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E5E7EB" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="Bd" Property="Background" Value="#E8F8EF" />
                                <Setter Property="Foreground" Value="#07C160" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 二级样式栏：画笔粗细/字号圆点按钮 -->
        <Style x:Key="SizeDotBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#6B7280" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1.5"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F2F3F5" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="Bd" Property="Background" Value="#E8F8EF" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#07C160" />
                                <Setter Property="Foreground" Value="#07C160" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 选区 8 向精致圆点缩放手柄（微信 4.0 极细绿系 + 白色描边） -->
        <Style x:Key="ShotResizeHandleStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="6" />
            <Setter Property="Height" Value="6" />
            <Setter Property="Fill" Value="#07C160" />
            <Setter Property="Stroke" Value="#FFFFFF" />
            <Setter Property="StrokeThickness" Value="1.3" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>

        <!-- 放大镜细腻像素网格画刷（每格 9×9 DIP 严格对齐单个物理像素） -->
        <DrawingBrush x:Key="MagnifierPixelGridBrush"
                      TileMode="Tile"
                      Viewport="0,0,9,9"
                      ViewportUnits="Absolute"
                      Viewbox="0,0,9,9"
                      ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#2A808080" Thickness="0.7" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <LineGeometry StartPoint="0,0" EndPoint="9,0" />
                            <LineGeometry StartPoint="0,0" EndPoint="0,9" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </Window.Resources>

    <Grid>
        <!-- 冻结的全虚拟桌面静态底图 -->
        <Image x:Name="FrozenBgImage"
               Stretch="Fill"
               RenderOptions.BitmapScalingMode="NearestNeighbor"
               IsHitTestVisible="False" />

        <Canvas x:Name="RootCanvas" Background="Transparent">
            <!-- 清爽通透的暗色遮罩（40% 不透明度），选区或吸附控件通过 CombinedGeometry 镂空 -->
            <Path x:Name="DimOverlayPath" Fill="#66000000" IsHitTestVisible="False" />

            <!-- 矢量标注实时渲染图层（严格裁切在选区内） -->
            <local:AnnotationLayerElement x:Name="AnnotationLayer" />

            <!-- Phase 3 原图沉浸式自由划词图层 -->
            <local:OcrSelectionLayer x:Name="OcrSelectionLayer" Visibility="Collapsed" />

            <!-- 选区边框（微信 4.0 实拍同款极细微信绿 #07C160，悬停吸附 2.5px / 编辑拖拽 1.5px 外描边） -->
            <Border x:Name="SelectionBorder"
                    Visibility="Collapsed"
                    BorderBrush="#07C160"
                    BorderThickness="1.5"
                    Background="Transparent"
                    SnapsToDevicePixels="True"
                    IsHitTestVisible="False" />

            <!-- 8 个精致圆点缩放手柄 -->
            <Ellipse x:Name="HandleTL" Style="{StaticResource ShotResizeHandleStyle}" />
            <Ellipse x:Name="HandleT"  Style="{StaticResource ShotResizeHandleStyle}" />
            <Ellipse x:Name="HandleTR" Style="{StaticResource ShotResizeHandleStyle}" />
            <Ellipse x:Name="HandleR"  Style="{StaticResource ShotResizeHandleStyle}" />
            <Ellipse x:Name="HandleBR" Style="{StaticResource ShotResizeHandleStyle}" />
            <Ellipse x:Name="HandleB"  Style="{StaticResource ShotResizeHandleStyle}" />
            <Ellipse x:Name="HandleBL" Style="{StaticResource ShotResizeHandleStyle}" />
            <Ellipse x:Name="HandleL"  Style="{StaticResource ShotResizeHandleStyle}" />

            <!-- 选区物理像素尺寸胶囊（微信紧凑深黑风格） -->
            <Border x:Name="SizeBadge"
                    Visibility="Collapsed"
                    Background="#C81C1C1E"
                    CornerRadius="4"
                    Padding="8,3"
                    IsHitTestVisible="False">
                <TextBlock x:Name="SizeBadgeText"
                           Foreground="#F5F5F7"
                           FontFamily="Segoe UI, Consolas, Microsoft YaHei UI"
                           FontSize="11.5"
                           FontWeight="Medium" />
            </Border>

            <!-- 原位透明文字标注输入框 -->
            <Border x:Name="InlineTextBoxContainer"
                    Visibility="Collapsed"
                    BorderBrush="#07C160"
                    BorderThickness="1.2"
                    Background="#28000000"
                    CornerRadius="3"
                    Padding="3,1">
                <TextBox x:Name="InlineTextBox"
                         Background="Transparent"
                         BorderThickness="0"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         MinWidth="60"
                         MinHeight="24"
                         FontFamily="Microsoft YaHei UI, Segoe UI"
                         FontWeight="SemiBold"
                         CaretBrush="#07C160"
                         PreviewKeyDown="InlineTextBox_PreviewKeyDown"
                         LostKeyboardFocus="InlineTextBox_LostKeyboardFocus" />
            </Border>

            <!-- 微信风格宽屏像素放大镜 + 取色浮窗（17×11 物理像素 × 9倍 = 153×99） -->
            <Border x:Name="MagnifierPanel"
                    Visibility="Collapsed"
                    Background="#EE1C1C1E"
                    BorderBrush="#40FFFFFF"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="0"
                    IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16"
                                      ShadowDepth="4"
                                      Direction="270"
                                      Opacity="0.34"
                                      Color="#000000" />
                </Border.Effect>
                <StackPanel Width="153">
                    <!-- 放大像素视窗（紧贴卡片顶部边缘，带细腻像素网格 + 中心镂空高反差十字准星） -->
                    <Border BorderBrush="#26FFFFFF" BorderThickness="0,0,0,1">
                        <Grid Width="153"
                              Height="99"
                              Clip="M 0,5 A 5,5 0 0 1 5,0 L 148,0 A 5,5 0 0 1 153,5 L 153,99 L 0,99 Z"
                              SnapsToDevicePixels="True">
                            <Image x:Name="MagnifierImage"
                                   Width="153"
                                   Height="99"
                                   Stretch="Fill"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor" />

                            <!-- 像素格网 -->
                            <Rectangle Width="153"
                                       Height="99"
                                       Fill="{StaticResource MagnifierPixelGridBrush}" />

                            <!-- 中心像素 [72..81, 45..54] 完全镂空的四向高对比十字准星 -->
                            <Canvas Width="153" Height="99">
                                <!-- 暗色托底确保在白色/亮绿背景上同样清晰 -->
                                <Rectangle Canvas.Left="0"  Canvas.Top="48" Width="70" Height="3" Fill="#66000000" />
                                <Rectangle Canvas.Left="83" Canvas.Top="48" Width="70" Height="3" Fill="#66000000" />
                                <Rectangle Canvas.Left="75" Canvas.Top="0"  Width="3" Height="43" Fill="#66000000" />
                                <Rectangle Canvas.Left="75" Canvas.Top="56" Width="3" Height="43" Fill="#66000000" />

                                <!-- 微信绿十字核心线 -->
                                <Rectangle Canvas.Left="0"  Canvas.Top="49" Width="70" Height="1" Fill="#F007C160" />
                                <Rectangle Canvas.Left="83" Canvas.Top="49" Width="70" Height="1" Fill="#F007C160" />
                                <Rectangle Canvas.Left="76" Canvas.Top="0"  Width="1" Height="43" Fill="#F007C160" />
                                <Rectangle Canvas.Left="76" Canvas.Top="56" Width="1" Height="43" Fill="#F007C160" />

                                <!-- 精准外框：紧贴中心 9×9 像素格外部，绝不遮挡中心像素颜色 -->
                                <Border Canvas.Left="70"
                                        Canvas.Top="43"
                                        Width="13"
                                        Height="13"
                                        BorderBrush="#99000000"
                                        BorderThickness="1" />
                                <Border Canvas.Left="71"
                                        Canvas.Top="44"
                                        Width="11"
                                        Height="11"
                                        BorderBrush="#FFFFFF"
                                        BorderThickness="1" />
                            </Canvas>
                        </Grid>
                    </Border>

                    <!-- 底部紧凑暗色信息区 -->
                    <StackPanel Margin="8,6,8,6">
                        <TextBlock x:Name="CoordText"
                                   Text="POS: 0, 0"
                                   Foreground="#B4B4BC"
                                   FontFamily="Consolas, Segoe UI"
                                   FontSize="10.5" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,3,0,0">
                            <Border x:Name="ColorSwatch"
                                    Width="11"
                                    Height="11"
                                    CornerRadius="2"
                                    BorderBrush="#B0FFFFFF"
                                    BorderThickness="1"
                                    Margin="0,0,6,0" />
                            <TextBlock x:Name="ColorValueText"
                                       Text="#000000"
                                       Foreground="#F5F5F7"
                                       FontFamily="Consolas, Segoe UI"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="MagnifierHintText"
                                   Text="C 复制 · Shift 切换"
                                   Foreground="#8E8E93"
                                   FontFamily="Microsoft YaHei UI, Segoe UI"
                                   FontSize="10"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 微信 4.0 同款纯白主标注工具条（纤细线性图标 + 宽敞留白 + 无实心块完成对勾） -->
            <Border x:Name="ActionToolbar"
                    Visibility="Collapsed"
                    Background="#FFFFFF"
                    BorderBrush="#14000000"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="8,5"
                    Cursor="Arrow">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20"
                                      ShadowDepth="4"
                                      Direction="270"
                                      Opacity="0.16"
                                      Color="#000000" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 矩形 (1) -->
                    <Button x:Name="RectToolBtn"
                            Style="{StaticResource ShotToolbarIconBtnStyle}"
                            ToolTip="矩形 (1 · 按住 Shift 正方形)"
                            Click="ToolButton_Click">
                        <Rectangle Width="17" Height="15" RadiusX="1.8" RadiusY="1.8"
                                   Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                   StrokeThickness="1.45" />
                    </Button>

                    <!-- 圆形 / 椭圆 (2) -->
                    <Button x:Name="EllipseToolBtn"
                            Style="{StaticResource ShotToolbarIconBtnStyle}"
                            ToolTip="椭圆 (2 · 按住 Shift 正圆)"
                            Click="ToolButton_Click">
                        <Ellipse Width="17" Height="17"
                                 Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                 StrokeThickness="1.45" />
                    </Button>

                    <!-- Emoji 表情贴纸（微信实拍同款笑脸图标）(9) -->
                    <Button x:Name="EmojiToolBtn"
                            Style="{StaticResource ShotToolbarIconBtnStyle}"
                            ToolTip="Emoji 彩色表情贴纸 (9)"
                            Click="ToolButton_Click">
                        <Grid Width="17" Height="17">
                            <Ellipse Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                     StrokeThickness="1.45" />
                            <Ellipse Width="2.1" Height="2.1"
                                     Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                     HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4.4,5.4,0,0" />
                            <Ellipse Width="2.1" Height="2.1"
                                     Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5.4,4.4,0" />
                            <Path Stretch="None"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.35"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M 5.2,10.2 C 6.3,12.2 10.7,12.2 11.8,10.2" />
                        </Grid>
                    </Button>

                    <!-- 箭头 (3) -->
                    <Button x:Name="ArrowToolBtn"
                            Style="{StaticResource ShotToolbarIconBtnStyle}"
                            ToolTip="箭头 (3)"
                            Click="ToolButton_Click">
                        <Path Width="17" Height="17" Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Data="M 3,14 L 14,3 M 7.5,3 H 14 V 9.5" />
                    </Button>

                    <!-- 画笔 (4) -->
                    <Button x:Name="PenToolBtn"
                            Style="{StaticResource ShotToolbarIconBtnStyle}"
                            ToolTip="画笔 (4)"
                            Click="ToolButton_Click">
                        <Path Width="17" Height="17" Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.45"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Data="M 12,2.5 L 14.5,5 L 6,13.5 L 2.5,14.5 L 3.5,11 Z M 9.8,4.7 L 12.3,7.2" />
                    </Button>

                    <!-- 荧光笔 (5) -->
                    <Button x:Name="HighlighterToolBtn"
                            Style="{StaticResource ShotToolbarIconBtnStyle}"
                            ToolTip="荧光笔 (5 · 半透明高亮)"
                            Click="ToolButton_Click">
                        <Path Width="17" Height="17" Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.45"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Data="M 10,2 L 14.5,6.5 L 7.2,13.8 L 3,13.8 L 3,9.6 Z M 2,16 H 15" />
                    </Button>

                    <!-- 序号 (6) -->
                    <Button x:Name="NumberToolBtn"
                            Style="{StaticResource ShotToolbarIconBtnStyle}"
                            ToolTip="序号标注 ①②③ (6)"
                            Click="ToolButton_Click">
                        <Grid Width="17" Height="17">
                            <Ellipse Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                     StrokeThickness="1.45" />
                            <TextBlock Text="1"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="0,-0.5,0,0" />
                        </Grid>
                    </Button>

                    <!-- 马赛克（微信同款带外框细棋盘格）(7) -->
                    <Button x:Name="MosaicToolBtn"
                            Style="{StaticResource ShotToolbarIconBtnStyle}"
                            ToolTip="马赛克 / 模糊打码 (7)"
                            Click="ToolButton_Click">
                        <Grid Width="17" Height="17">
                            <Rectangle RadiusX="2" RadiusY="2"
                                       Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                       StrokeThickness="1.4" />
                            <Path Width="11" Height="11" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M0,0 H3 V3 H0 Z M6,0 H9 V3 H6 Z M3,3 H6 V6 H3 Z M9,3 H12 V6 H9 Z M0,6 H3 V9 H0 Z M6,6 H9 V9 H6 Z M3,9 H6 V12 H3 Z M9,9 H12 V12 H9 Z" />
                        </Grid>
                    </Button>

                    <!-- 文字（微信同款方框内嵌纯矢量居中 T）(8) -->
                    <Button x:Name="TextToolBtn"
                            Style="{StaticResource ShotToolbarIconBtnStyle}"
                            ToolTip="文字标注 (8)"
                            Click="ToolButton_Click">
                        <Grid Width="17" Height="17">
                            <Rectangle RadiusX="2.2" RadiusY="2.2"
                                       Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                       StrokeThickness="1.4" />
                            <Path Stretch="None"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.45"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M 5.2,5.3 H 11.8 M 8.5,5.3 V 12.1" />
                        </Grid>
                    </Button>

                    <Border Width="1" Height="22" Background="#EAEAEA" Margin="6,0" />

                    <!-- 撤销 -->
                    <Button x:Name="UndoBtn"
                            Style="{StaticResource ShotToolbarIconBtnStyle}"
                            IsEnabled="False"
                            ToolTip="撤销 (Ctrl+Z)"
                            Click="UndoButton_Click">
                        <Path Width="17" Height="17" Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.45"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Data="M 4.5,6.5 H 10.8 C 13.5,6.5 15.2,8.2 15.2,10.6 C 15.2,13 13.3,14.5 10.8,14.5 H 7.5 M 7.2,3.8 L 4,6.5 L 7.2,9.2" />
                    </Button>

                    <!-- 重做 -->
                    <Button x:Name="RedoBtn"
                            Style="{StaticResource ShotToolbarIconBtnStyle}"
                            IsEnabled="False"
                            ToolTip="重做 (Ctrl+Y)"
                            Click="RedoButton_Click">
                        <Path Width="17" Height="17" Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.45"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Data="M 12.5,6.5 H 6.2 C 3.5,6.5 1.8,8.2 1.8,10.6 C 1.8,13 3.7,14.5 6.2,14.5 H 9.5 M 9.8,3.8 L 13,6.5 L 9.8,9.2" />
                    </Button>

                    <!-- 删除选中标注 -->
                    <Button x:Name="DeleteAnnoBtn"
                            Style="{StaticResource ShotToolbarIconBtnStyle}"
                            IsEnabled="False"
                            ToolTip="删除选中标注 (Delete)"
                            Click="DeleteAnnoButton_Click">
                        <Path Width="16" Height="17" Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Data="M 3,5 H 14 M 6.2,2.5 H 10.8 M 4.6,5 V 14.8 H 12.4 V 5 M 7.2,7.8 V 12.2 M 9.8,7.8 V 12.2" />
                    </Button>

                    <Border Width="1" Height="22" Background="#EAEAEA" Margin="6,0" />

                    <!-- 取色 / 吸管 (I) -->
                    <Button x:Name="ColorPickerBtn"
                            Style="{StaticResource ShotToolbarIconBtnStyle}"
                            ToolTip="取色 / 吸管 (I · 左键或 C 复制 · Shift 切换 HEX/RGB)"
                            Click="ColorPickerButton_Click">
                        <Path Width="17" Height="17" Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.45"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Data="M 13.5,2.4 C 14.4,3.3 14.4,4.8 13.5,5.7 L 11.2,8 L 9,5.8 L 11.3,3.5 C 12.2,2.6 12.6,2.2 13.5,2.4 Z M 8.2,4.9 L 12.1,8.8 M 10.4,7.8 L 5.6,12.6 L 2.5,14.2 L 4.1,11.1 L 8.9,6.3" />
                    </Button>

                    <!-- 提取文字 OCR（微信同款四角取景框内嵌 文）(O) -->
                    <Button x:Name="OcrBtn"
                            Style="{StaticResource ShotToolbarIconBtnStyle}"
                            ToolTip="提取文字 OCR (O)"
                            Click="OcrButton_Click">
                        <Grid Width="18" Height="18">
                            <Path Stretch="None"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M 1.5,5.5 V 2.5 A 1,1 0 0 1 2.5,1.5 H 5.5 M 12.5,1.5 H 15.5 A 1,1 0 0 1 16.5,2.5 V 5.5 M 16.5,12.5 V 15.5 A 1,1 0 0 1 15.5,16.5 H 12.5 M 5.5,16.5 H 2.5 A 1,1 0 0 1 1.5,15.5 V 12.5" />
                            <TextBlock Text="文"
                                       FontFamily="Microsoft YaHei UI, Segoe UI"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="0,-0.5,0,0" />
                        </Grid>
                    </Button>

                    <!-- 滚动截长图（微信实拍同款上下框 + 双向箭头）(L) -->
                    <Button x:Name="LongShotBtn"
                            Style="{StaticResource ShotToolbarIconBtnStyle}"
                            ToolTip="滚动截长图 (L · 支持手动滚轮与自动滚动拼接)"
                            Click="LongShotButton_Click">
                        <Path Width="17" Height="18" Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Data="M 3,4.8 V 2.5 A 1,1 0 0 1 4,1.5 H 13 A 1,1 0 0 1 14,2.5 V 4.8 M 3,13.2 V 15.5 A 1,1 0 0 0 4,16.5 H 13 A 1,1 0 0 0 14,15.5 V 13.2 M 8.5,4.2 V 13.8 M 6.2,6.5 L 8.5,4.2 L 10.8,6.5 M 6.2,11.5 L 8.5,13.8 L 10.8,11.5" />
                    </Button>

                    <!-- 贴图 Pin -->
                    <Button Style="{StaticResource ShotToolbarIconBtnStyle}"
                            ToolTip="钉在桌面上置顶贴图"
                            Click="PinButton_Click">
                        <Path Width="17" Height="17" Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.45"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Data="M 10,2 L 14.8,6.8 L 11.7,8.4 L 10.6,11.6 L 5.2,6.2 L 8.4,5.1 Z M 7.9,8.9 L 2.5,14.3" />
                    </Button>

                    <!-- 转入区域隐身录屏（统一红色录屏图标） -->
                    <Button Style="{StaticResource ShotToolbarIconBtnStyle}"
                            ToolTip="以此选区立即开始隐身录屏"
                            Click="RecordNowButton_Click">
                        <Grid Width="16" Height="16">
                            <Ellipse Stroke="#F05252" StrokeThickness="1.45" />
                            <Ellipse Width="7" Height="7" Fill="#F05252" />
                        </Grid>
                    </Button>

                    <!-- 保存 PNG -->
                    <Button Style="{StaticResource ShotToolbarIconBtnStyle}"
                            ToolTip="保存为 PNG 文件 (Ctrl+S)"
                            Click="SaveButton_Click">
                        <Path Width="17" Height="17" Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.45"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Data="M 8.5,2.5 V 11 M 5.2,8 L 8.5,11.3 L 11.8,8 M 2.5,11.5 V 14.2 H 14.5 V 11.5" />
                    </Button>

                    <Border Width="1" Height="22" Background="#EAEAEA" Margin="6,0" />

                    <!-- 重新框选 -->
                    <Button Style="{StaticResource ShotToolbarIconBtnStyle}"
                            ToolTip="重新选择区域"
                            Click="ReselectButton_Click">
                        <Path Width="17" Height="17" Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.45"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Data="M 14,8.5 A 5.5,5.5 0 1 1 12.2,4.5 M 13.5,2 V 5.2 H 10.3" />
                    </Button>

                    <!-- 取消退出（微信同款透明底柔红细叉） -->
                    <Button Style="{StaticResource DangerToolbarIconBtnStyle}"
                            ToolTip="取消退出 (Esc)"
                            Click="CancelButton_Click">
                        <Path Width="15" Height="15" Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.65"
                              StrokeStartLineCap="Round"
                              Data="M 3,3 L 12.5,12.5 M 12.5,3 L 3,12.5" />
                    </Button>

                    <!-- 完成按钮（微信 4.0 同款透明底微信绿纤细对勾） -->
                    <Button Style="{StaticResource PrimaryConfirmBtnStyle}"
                            ToolTip="复制到剪贴板并完成 (Enter / 双击选区)"
                            Click="ConfirmButton_Click">
                        <Path Width="18" Height="18" Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.85"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Data="M 2.5,9.2 L 7.2,13.8 L 15.8,4.2" />
                    </Button>
                </StackPanel>
            </Border>

            <!-- 二级样式浮条（粗细/字号/强度 + 色板或马赛克模式） -->
            <Border x:Name="StyleSubBar"
                    Visibility="Collapsed"
                    Background="#FFFFFF"
                    BorderBrush="#1F000000"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10,5"
                    Cursor="Arrow">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16"
                                      ShadowDepth="4"
                                      Direction="270"
                                      Opacity="0.16"
                                      Color="#000000" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 3 档大小圆点 -->
                    <Button x:Name="SizeSmallBtn"
                            Style="{StaticResource SizeDotBtnStyle}"
                            ToolTip="细 / 小号"
                            Click="SizeSmallBtn_Click">
                        <Ellipse Width="6" Height="6" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button x:Name="SizeMediumBtn"
                            Style="{StaticResource SizeDotBtnStyle}"
                            ToolTip="中"
                            Click="SizeMediumBtn_Click">
                        <Ellipse Width="10" Height="10" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button x:Name="SizeLargeBtn"
                            Style="{StaticResource SizeDotBtnStyle}"
                            ToolTip="粗 / 大号"
                            Click="SizeLargeBtn_Click">
                        <Ellipse Width="14" Height="14" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>

                    <Border Width="1" Height="18" Background="#E5E7EB" Margin="8,0" />

                    <!-- 8 色精选色板容器（由后台动态绑定选中高亮） -->
                    <StackPanel x:Name="ColorPalettePanel"
                                Orientation="Horizontal"
                                VerticalAlignment="Center" />

                    <!-- 马赛克双模式切换（仅马赛克工具时显示） -->
                    <StackPanel x:Name="MosaicModePanel"
                                Visibility="Collapsed"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button x:Name="MosaicPixelBtn"
                                Style="{StaticResource SubBarModeBtnStyle}"
                                Content="像素块"
                                Click="MosaicPixelBtn_Click"
                                Margin="0,0,4,0" />
                        <Button x:Name="MosaicBlurBtn"
                                Style="{StaticResource SubBarModeBtnStyle}"
                                Content="高斯模糊"
                                Click="MosaicBlurBtn_Click" />
                    </StackPanel>

                    <!-- Emoji 彩色表情选择面板（仅 Emoji 工具时显示，2行×12列） -->
                    <WrapPanel x:Name="EmojiPickerPanel"
                               Visibility="Collapsed"
                               Width="384"
                               Orientation="Horizontal"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- 划词松手后的极简复制气泡 -->
            <Border x:Name="OcrSelectionBubble"
                    Visibility="Collapsed"
                    Background="#FFFFFF"
                    BorderBrush="#1F000000"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="5,4"
                    Cursor="Arrow">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14"
                                      ShadowDepth="3"
                                      Direction="270"
                                      Opacity="0.18"
                                      Color="#000000" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Height="28"
                            Padding="11,0"
                            Background="#07C160"
                            BorderThickness="0"
                            Foreground="#FFFFFF"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Focusable="False"
                            Content="复制"
                            ToolTip="复制所选文字 (Ctrl+C)"
                            Click="OcrBubbleCopyBtn_Click"
                            Margin="0,0,4,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#06AD56" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Style="{StaticResource SubBarModeBtnStyle}"
                            Height="28"
                            Content="去换行复制"
                            ToolTip="合并换行后复制所选文字"
                            Click="OcrBubbleJoinCopyBtn_Click" />
                </StackPanel>
            </Border>

            <!-- OCR 模式轻量单行操作栏 -->
            <Border x:Name="OcrActionBar"
                    Visibility="Collapsed"
                    Background="#FFFFFF"
                    BorderBrush="#1F000000"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10,5"
                    Cursor="Arrow">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16"
                                      ShadowDepth="4"
                                      Direction="270"
                                      Opacity="0.16"
                                      Color="#000000" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="OcrBarStatusText"
                               Text="拖动原图划词"
                               Foreground="#4B5563"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="2,0,10,0" />
                    <Border Width="1" Height="16" Background="#E5E7EB" Margin="0,0,8,0" />
                    <Button x:Name="OcrSelectAllBtn"
                            Style="{StaticResource SubBarModeBtnStyle}"
                            Content="全选 (Ctrl+A)"
                            Click="OcrSelectAllBtn_Click"
                            Margin="0,0,4,0" />
                    <Button x:Name="OcrCopyAllBtn"
                            Style="{StaticResource SubBarModeBtnStyle}"
                            Content="复制全部"
                            Click="OcrCopyAllBtn_Click"
                            Margin="0,0,4,0" />
                    <Button x:Name="OcrOpenEditorBtn"
                            Style="{StaticResource SubBarModeBtnStyle}"
                            Content="大窗编辑"
                            ToolTip="在宽敞独立窗口中编辑全部文字"
                            Click="OcrOpenEditorBtn_Click"
                            Margin="0,0,6,0" />
                    <Button Style="{StaticResource SubBarModeBtnStyle}"
                            Foreground="#FA5151"
                            Content="退出"
                            Click="CloseOcrBtn_Click" />
                </StackPanel>
            </Border>

            <!-- 顶部提示胶囊（兼作色值复制反馈） -->
            <Border x:Name="HintPill"
                    Background="#CC1C1C1E"
                    BorderBrush="#26FFFFFF"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="16,7"
                    IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12"
                                      ShadowDepth="2"
                                      Direction="270"
                                      Opacity="0.25"
                                      Color="#000000" />
                </Border.Effect>
                <TextBlock x:Name="HintPillText"
                           Text="悬停自动吸附 · 拖动框选 · ↑↓←→ 微调 · C 复制色值并退出 · Esc 取消"
                           Foreground="#F2F2F7"
                           FontFamily="Microsoft YaHei UI, Segoe UI"
                           FontSize="12" />
            </Border>
        </Canvas>
    </Grid>
</Window>
