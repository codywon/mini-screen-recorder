<Window x:Class="MiniRec.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="发现新版本 - MiniRec"
        Width="356"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="UpdateSecondaryBtnStyle" TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Foreground" Value="#CBD5E1" />
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#273549" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="UpdatePrimaryBtnStyle" TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#07C160" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#06AD56" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#05984B" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="UpdateTextLinkStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#CBD5E1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="12"
            Background="#F50F172A"
            BorderBrush="#334155"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16,14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12"
                              ShadowDepth="3"
                              Direction="270"
                              Opacity="0.4"
                              Color="#000000" />
        </Border.Effect>

        <StackPanel>
            <!-- 标题行（可拖拽） -->
            <Grid Background="Transparent"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="#07C160" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="TitleVersionText"
                               Text="发现新版本 v1.1.0"
                               Foreground="#F8FAFC"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
                <Button HorizontalAlignment="Right"
                        Width="22"
                        Height="22"
                        Content="✕"
                        Foreground="#64748B"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Focusable="False"
                        Click="LaterButton_Click" />
            </Grid>

            <!-- 极简版本副信息 -->
            <TextBlock x:Name="SubInfoText"
                       Text="当前 v1.0.0"
                       Foreground="#64748B"
                       FontFamily="Consolas, Segoe UI"
                       FontSize="11.5"
                       Margin="16,3,0,11" />

            <!-- 精简更新内容区 -->
            <Border Background="#162033"
                    CornerRadius="8"
                    Padding="11,9"
                    Margin="0,0,0,12">
                <ScrollViewer MaxHeight="104"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="NotesText"
                               Foreground="#CBD5E1"
                               FontFamily="Microsoft YaHei UI, Segoe UI"
                               FontSize="12"
                               LineHeight="19"
                               TextWrapping="Wrap" />
                </ScrollViewer>
            </Border>

            <!-- 下载进度（仅更新时展开） -->
            <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,0,0,12">
                <Grid Margin="0,0,0,5">
                    <TextBlock x:Name="ProgressStageText"
                               Text="正在下载..."
                               Foreground="#CBD5E1"
                               FontSize="11.5" />
                    <TextBlock x:Name="ProgressDetailText"
                               HorizontalAlignment="Right"
                               Foreground="#94A3B8"
                               FontFamily="Consolas, Segoe UI"
                               FontSize="11" />
                </Grid>
                <ProgressBar x:Name="DownloadProgressBar"
                             Height="4"
                             Minimum="0"
                             Maximum="100"
                             Background="#1E293B"
                             Foreground="#07C160"
                             BorderThickness="0" />
            </StackPanel>

            <!-- 异常/手动兜底提示（仅失败或调试态显示） -->
            <Border x:Name="AlertBanner"
                    Visibility="Collapsed"
                    Background="#2A171C"
                    CornerRadius="7"
                    Padding="10,7"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock x:Name="AlertText"
                               Foreground="#FCA5A5"
                               FontSize="11.5"
                               TextWrapping="Wrap"
                               LineHeight="17" />
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <Button x:Name="OpenDownloadedFolderBtn"
                                Visibility="Collapsed"
                                Style="{StaticResource UpdateTextLinkStyle}"
                                Foreground="#60A5FA"
                                Margin="0,0,12,0"
                                Content="打开下载目录 ↗"
                                Click="OpenDownloadedFolderBtn_Click" />
                        <Button x:Name="OpenReleaseLinkBtn"
                                Style="{StaticResource UpdateTextLinkStyle}"
                                Foreground="#60A5FA"
                                Content="前往发布页手动下载 ↗"
                                Click="OpenReleasePageButton_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 底部极简操作栏 -->
            <Grid>
                <Button x:Name="SkipVersionBtn"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Style="{StaticResource UpdateTextLinkStyle}"
                        Content="忽略此版本"
                        Click="SkipVersionButton_Click" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="LaterBtn"
                            Style="{StaticResource UpdateSecondaryBtnStyle}"
                            Content="稍后"
                            Margin="0,0,8,0"
                            Click="LaterButton_Click" />
                    <Button x:Name="UpdateNowBtn"
                            Style="{StaticResource UpdatePrimaryBtnStyle}"
                            Content="立即更新"
                            Click="UpdateNowButton_Click" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>
