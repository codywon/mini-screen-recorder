<Window x:Class="MiniRec.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="发现新版本 - MiniRec"
        Width="424"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="UpdateSecondaryBtnStyle" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="Foreground" Value="#CBD5E1" />
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#273549" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="UpdatePrimaryBtnStyle" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="15,0" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#07C160" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#06AD56" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#05984B" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="UpdateLinkBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Padding" Value="2,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#E2E8F0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="12"
            Background="#F50F172A"
            BorderBrush="#334155"
            BorderThickness="1"
            CornerRadius="12"
            Padding="18,15">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14"
                              ShadowDepth="3"
                              Direction="270"
                              Opacity="0.42"
                              Color="#000000" />
        </Border.Effect>

        <StackPanel>
            <!-- 标题栏 -->
            <Grid Margin="0,0,0,12"
                  Background="Transparent"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Fill="#07C160" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="发现 MiniRec 新版本"
                               Foreground="#F8FAFC"
                               FontSize="14.5"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
                <Button x:Name="CloseIconBtn"
                        HorizontalAlignment="Right"
                        Width="24"
                        Height="24"
                        Content="✕"
                        Foreground="#94A3B8"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Focusable="False"
                        Click="LaterButton_Click" />
            </Grid>

            <!-- 版本对比胶囊 -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                <Border Background="#1E293B"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="8,3">
                    <TextBlock x:Name="CurrentVersionText"
                               Text="v1.0.0"
                               Foreground="#CBD5E1"
                               FontFamily="Consolas, Segoe UI"
                               FontSize="12" />
                </Border>
                <TextBlock Text="→"
                           Foreground="#64748B"
                           FontSize="13"
                           Margin="8,0"
                           VerticalAlignment="Center" />
                <Border Background="#123A28"
                        BorderBrush="#07C160"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="8,3">
                    <TextBlock x:Name="RemoteVersionText"
                               Text="v1.1.0"
                               Foreground="#4ADE80"
                               FontFamily="Consolas, Segoe UI"
                               FontSize="12"
                               FontWeight="SemiBold" />
                </Border>
                <TextBlock x:Name="PublishedDateText"
                           Foreground="#64748B"
                           FontSize="11.5"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- 更新说明 -->
            <Border Background="#1E293B"
                    BorderBrush="#334155"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,10"
                    Margin="0,0,0,12">
                <ScrollViewer MaxHeight="148"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="NotesText"
                               Foreground="#E2E8F0"
                               FontFamily="Microsoft YaHei UI, Segoe UI"
                               FontSize="12"
                               LineHeight="19"
                               TextWrapping="Wrap" />
                </ScrollViewer>
            </Border>

            <!-- 下载进度面板 -->
            <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,0,0,12">
                <Grid Margin="0,0,0,5">
                    <TextBlock x:Name="ProgressStageText"
                               Text="正在下载安装包..."
                               Foreground="#CBD5E1"
                               FontSize="11.5" />
                    <TextBlock x:Name="ProgressDetailText"
                               HorizontalAlignment="Right"
                               Foreground="#94A3B8"
                               FontFamily="Consolas, Segoe UI"
                               FontSize="11.5" />
                </Grid>
                <ProgressBar x:Name="DownloadProgressBar"
                             Height="6"
                             Minimum="0"
                             Maximum="100"
                             Background="#1E293B"
                             Foreground="#07C160"
                             BorderThickness="0" />
            </StackPanel>

            <!-- 状态/错误提示条 -->
            <Border x:Name="AlertBanner"
                    Visibility="Collapsed"
                    Background="#2A171C"
                    BorderBrush="#7F1D1D"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="10,7"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock x:Name="AlertText"
                               Foreground="#FCA5A5"
                               FontSize="11.5"
                               TextWrapping="Wrap"
                               LineHeight="17" />
                    <Button x:Name="OpenDownloadedFolderBtn"
                            Visibility="Collapsed"
                            Style="{StaticResource UpdateLinkBtnStyle}"
                            Foreground="#60A5FA"
                            HorizontalAlignment="Left"
                            Margin="0,4,0,0"
                            Content="打开已下载文件所在目录 ↗"
                            Click="OpenDownloadedFolderBtn_Click" />
                </StackPanel>
            </Border>

            <!-- 底部操作栏 -->
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Button x:Name="SkipVersionBtn"
                            Style="{StaticResource UpdateLinkBtnStyle}"
                            Content="忽略此版本"
                            Margin="0,0,10,0"
                            Click="SkipVersionButton_Click" />
                    <Button Style="{StaticResource UpdateLinkBtnStyle}"
                            Foreground="#60A5FA"
                            Content="查看发布页 ↗"
                            Click="OpenReleasePageButton_Click" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="LaterBtn"
                            Style="{StaticResource UpdateSecondaryBtnStyle}"
                            Content="稍后再说"
                            Margin="0,0,8,0"
                            Click="LaterButton_Click" />
                    <Button x:Name="UpdateNowBtn"
                            Style="{StaticResource UpdatePrimaryBtnStyle}"
                            Content="立即更新"
                            Click="UpdateNowButton_Click" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>
